---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <section class="wrap nf">
    <h1 class="display">Out of reach.</h1>
    <p class="muted">That page doesn't exist. It may have moved when a project was renamed.</p>
    <a class="btn btn-primary" href="/#projects">
      Back to projects
    </a>
  </section>
</Base>

<style>
  .nf {
    padding-block: 8rem 4rem;
  }
  h1 {
    font-size: clamp(3rem, 9vw, 6rem);
    margin: 0 0 1rem;
  }
  p {
    margin: 0 0 2rem;
  }
</style>

---
import { Icon } from 'astro-icon/components';
import { profile } from '../data/site';
const onHome = Astro.url.pathname === '/';
const link = (hash: string) => (onHome ? hash : `/${hash}`);
---

<header class="site-header">
  <div class="wrap bar">
    <a class="name" href="/">
      {profile.name}
    </a>
    <nav aria-label="Main">
      <a href={link('#projects')}>Projects</a>
      <a href={link('#now')}>Now</a>
      <a href={link('#experience')}>Experience</a>
      <a class="gh" href={profile.github} rel="me">
        <Icon name="simple-icons:github" aria-hidden="true" />
        <span>GitHub</span>
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--rule);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.5rem;
  }
  .name {
    font-family: var(--display);
    font-weight: 600;
    font-size: 1.15rem;
    text-decoration: none;
    white-space: nowrap;
  }
  nav {
    display: flex;
    gap: clamp(0.5rem, 2.5vw, 1.75rem);
    align-items: center;
  }
  nav a {
    text-decoration: none;
    color: var(--graphite);
    font-size: 0.95rem;
    padding: 0.6rem 0.1rem;
    transition: color 160ms ease;
  }
  nav a:hover {
    color: var(--ink);
  }
  .gh {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .gh :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
  }
  @media (max-width: 560px) {
    nav a[href$='#now'],
    nav a[href$='#experience'] {
      display: none;
    }
    .gh span {
      position: absolute;
      left: -999px;
    }
  }
</style>

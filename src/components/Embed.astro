---
import { Icon } from 'astro-icon/components';

interface Props {
  src: string;
  title: string;
  kind: 'play' | 'live';
  poster?: string;
}

const { src, title, kind, poster } = Astro.props;
const label = kind === 'play' ? `Start ${title}` : `Load ${title}`;
const note =
  kind === 'play'
    ? 'Runs fully in your browser. Desktop with a keyboard works best.'
    : 'The live app, embedded. Some features need an account.';
---

<figure class="embed" data-embed data-src={src} data-title={title}>
  <div class="frame">
    {poster && <img src={poster} alt="" loading="lazy" decoding="async" />}
    <button class="btn btn-primary start" type="button">
      <Icon
        name={kind === 'play' ? 'solar:gamepad-linear' : 'solar:global-linear'}
        aria-hidden="true"
      />
      {label}
    </button>
  </div>
  <figcaption class="muted">
    <span>{note}</span>
    <a href={src} target="_blank" rel="noopener">
      Open in a new tab
      <Icon name="solar:arrow-right-up-linear" aria-hidden="true" />
    </a>
  </figcaption>
</figure>

<script>
  // The iframe loads only on request, so a heavy game never slows the page down.
  document.querySelectorAll<HTMLElement>('[data-embed]').forEach((fig) => {
    const btn = fig.querySelector<HTMLButtonElement>('.start');
    btn?.addEventListener('click', () => {
      const frame = fig.querySelector('.frame')!;
      const iframe = document.createElement('iframe');
      iframe.src = fig.dataset.src!;
      iframe.title = fig.dataset.title!;
      // camera lets a live demo such as the Lumina webcam app read the viewer's camera.
      iframe.allow = 'fullscreen; gamepad; autoplay; camera';
      iframe.setAttribute('allowfullscreen', '');
      frame.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>

<style>
  .embed {
    margin: 0;
  }
  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border: 1.5px solid var(--ink);
    border-radius: 10px;
    overflow: hidden;
    background: var(--panel);
    display: grid;
    place-items: center;
  }
  .frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.85);
  }
  .frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    background: #fff;
  }
  .start {
    position: relative;
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.25);
  }
  .start :global(svg),
  figcaption :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-top: 0.6rem;
    font-size: 0.9rem;
  }
  figcaption a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--z);
  }
</style>

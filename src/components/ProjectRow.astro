---
import type { CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { coverFor } from '../lib/media';
import { categories } from '../data/site';

interface Props {
  project: CollectionEntry<'projects'>;
  size: 'feature' | 'compact';
}

const { project, size } = Astro.props;
const d = project.data;
const href = `/projects/${project.id}/`;
const cover = coverFor(project.id);
const axis = categories[d.category].axis;
const badge = d.play ? 'Play in browser' : d.live ? 'Live app' : cover.video ? 'Video demo' : '';
---

<article class:list={['row', size, `axis-${axis}`]}>
  {size === 'feature' && (
    <a class="media" href={href} tabindex="-1" aria-hidden="true">
      {cover.image ? (
        <img src={cover.image} alt="" loading="lazy" decoding="async" />
      ) : (
        <span class="placeholder">{d.status === 'in progress' ? 'In progress' : d.title}</span>
      )}
      {cover.video && (
        <video
          data-hover-video
          src={cover.video}
          muted
          loop
          playsinline
          preload="none"
          aria-hidden="true"
        />
      )}
    </a>
  )}
  <div class="body">
    <h3>
      <a href={href}>{d.title}</a>
    </h3>
    <p class="summary">{d.summary}</p>
    <ul class="stack" aria-label="Built with">
      {d.stack.slice(0, 5).map((s) => (
        <li>{s}</li>
      ))}
    </ul>
    <p class="meta muted">
      <span class="status" data-status={d.status}>
        {d.status}
      </span>
      <span class="num">{d.year}</span>
      {badge && (
        <span class="badge">
          <Icon
            name={
              d.play ? 'solar:gamepad-linear' : d.live ? 'solar:global-linear' : 'solar:play-linear'
            }
            aria-hidden="true"
          />
          {badge}
        </span>
      )}
    </p>
  </div>
</article>

<style>
  .row {
    position: relative;
    border-top: 1px solid var(--rule);
    padding-block: 1.5rem;
  }
  .feature {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: center;
    padding-block: 2rem;
  }
  .media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 8px;
    background: var(--panel);
    border: 1px solid var(--rule);
  }
  .media img,
  .media video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .media video {
    opacity: 0;
    transition: opacity 220ms ease;
  }
  .media video:global(.on) {
    opacity: 1;
  }
  .placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--display);
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    color: var(--axis);
    background:
      repeating-linear-gradient(
        0deg,
        transparent 0 19px,
        color-mix(in srgb, var(--rule) 60%, transparent) 19px 20px
      ),
      repeating-linear-gradient(
        90deg,
        transparent 0 19px,
        color-mix(in srgb, var(--rule) 60%, transparent) 19px 20px
      );
  }
  h3 {
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
    line-height: 1.05;
    margin: 0 0 0.5rem;
  }
  .compact h3 {
    font-size: 1.35rem;
  }
  h3 a {
    text-decoration: none;
    background-image: linear-gradient(var(--axis), var(--axis));
    background-size: 0 2px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 220ms ease;
  }
  /* The whole row is clickable through the heading link. */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .row:hover h3 a,
  h3 a:focus-visible {
    background-size: 100% 2px;
  }
  .summary {
    margin: 0 0 0.85rem;
    max-width: 58ch;
  }
  .compact {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .stack {
    list-style: none;
    padding: 0;
    margin: 0 0 0.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .stack li {
    font-size: 0.8rem;
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--graphite);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    align-items: center;
    margin: 0;
    font-size: 0.875rem;
  }
  .status::before {
    content: '';
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    margin-right: 0.4rem;
    background: var(--graphite);
    vertical-align: 0.05em;
  }
  .status[data-status='working']::before {
    background: var(--y);
  }
  .status[data-status='in progress']::before {
    background: var(--z);
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--axis);
    font-weight: 500;
  }
  .badge :global(svg) {
    width: 1rem;
    height: 1rem;
  }
  @media (max-width: 760px) {
    .feature {
      grid-template-columns: 1fr;
    }
  }
</style>
